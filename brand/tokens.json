    "sky":       { "base": "#A8D8F0", "tint": "#E2F2FB", "deep": "#1D5A7A", "role": "Explore, info, how-to-serve cards" },
    "plum":      { "base": "#C9B6F2", "tint": "#EFE8FC", "deep": "#4B2F8A", "role": "Ideas, recipes" },
